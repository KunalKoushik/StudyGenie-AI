# StudyGenie AI - Environment Variables Configuration

# 1. Google Gemini API Key (Required for live AI tutor, quiz generation, snap & solve, and syllabus planning)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Server Port (Default is 3000)
PORT=3000

# 3. Optional MongoDB Connection String (If persisting user profiles to MongoDB database)
MONGODB_URI=mongodb://localhost:27017/studygenie
