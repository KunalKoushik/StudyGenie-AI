# Environment Variables Configuration for StudyGenie AI

# Server Port
PORT=3000

# Environment (development | production)
NODE_ENV=development

# JWT Secret (MUST be at least 32 characters in production)
JWT_SECRET=your_minimum_32_character_jwt_secret_key_here

# Google Gemini API Key (Optional: system uses intelligent local fallback if omitted)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Name
GEMINI_MODEL=gemini-2.5-flash

# CORS Allowed Origin (e.g. https://studygenie.ai or * for local dev)
ALLOWED_ORIGIN=*
